# این فایل را کپی کنید به .env (یا همین مقادیر را در Variables ریلوی بگذارید)
# هرگز .env یا کلید واقعی را داخل کد/گیت نگذارید.

BOT_TOKEN=            # توکن ربات از BotFather (اجباری)
ADMIN_ID=             # آیدی عددی مالک ربات
CHANNEL_ID=           # کانال اصلی (اعزام، محاصره، جنگ) مثل -1001234567890
REPORT_CHANNEL_ID=    # کانال گزارش فنی برای ادمین
TWEET_CHANNEL_ID=     # کانال بیانیه‌ها
BACKUP_CHAT_ID=       # چت پشتیبان (خالی = پی‌وی مالک)
ADMIN_CODE=ADMIN      # کد ورود ادمین در پی‌وی ربات
DATA_FILE=data.json   # فایل داده محلی
XAI_API_KEY=          # کلید xAI/Grok برای مشاور (اختیاری؛ کلید رایگان سهمیه کمی دارد)
XAI_MODEL=grok-3-mini
